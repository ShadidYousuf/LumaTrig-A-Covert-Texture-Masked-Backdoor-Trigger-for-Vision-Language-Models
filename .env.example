# Copy this file to `.env` and fill in your token. `.env` is git-ignored; do not commit it.
#
# Hugging Face access token — needed to download gated models like MedGemma.
# Steps:
#   1) Create a READ token at https://huggingface.co/settings/tokens
#   2) Accept the MedGemma license at https://huggingface.co/google/medgemma-4b-it
#   3) Paste the token below as HF_TOKEN
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

MEDGEMMA_MODEL=google/medgemma-4b-it
